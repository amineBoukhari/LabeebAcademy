---
import Button from './Button.astro';
import { useTranslations, path } from '../i18n/utils.js';

const { locale = 'fr', routeKey = 'home', ctaHref = null, ctaLabel = null, headerBg = 'bg-bg/85' } = Astro.props;

const t = useTranslations(locale);
const otherLocale = locale === 'fr' ? 'ar' : 'fr';

const services = [
  { key: 'online', label: t('nav.online'), href: path('online', locale) },
  { key: 'presential', label: t('nav.presential'), href: path('presential', locale) },
  { key: 'mastermind', label: t('nav.mastermind'), href: '#' },
  { key: 'consulting', label: t('nav.consulting'), href: `${path('contact', locale)}?sujet=consulting` },
  { key: 'support', label: t('nav.support'), href: `${path('contact', locale)}?sujet=accompagnement` },
  { key: 'disc', label: t('nav.disc'), href: '#' }
];

const navLinks = [
  { key: 'travel', label: t('nav.travel'), href: path('travel', locale) },
  { key: 'team', label: t('nav.team'), href: path('team', locale) },
  { key: 'contact', label: t('nav.contact'), href: path('contact', locale) },
  { key: 'story', label: t('nav.story'), href: path('story', locale) }
];

const finalCtaHref = ctaHref ?? path('contact', locale);
const finalCtaLabel = ctaLabel ?? t('nav.write');
const altHref = path(routeKey, otherLocale);
const noMarker = '[&::-webkit-details-marker]:hidden [&::marker]:content-none';
---

<header class:list={['sticky top-0 z-20 border-b border-white/10 backdrop-blur-md', headerBg]}>
  <div class="mx-auto flex max-w-[1400px] items-center justify-between gap-6 px-5 py-4 sm:px-8">
    <a href={path('home', locale)} class="flex items-center gap-2.5">
      <span class="relative block h-[22px] w-[22px] bg-white [clip-path:polygon(0_16%,16%_0,100%_0,100%_68%,68%_100%,0_100%)]">
        <span class="absolute right-0 top-0 h-[62%] w-[56%] bg-acc [clip-path:polygon(0_0,100%_0,100%_74%,74%_100%,0_100%)]"></span>
      </span>
      <span class="whitespace-nowrap text-[13px] font-bold uppercase tracking-[0.18em]">Labeeb Academy</span>
    </a>

    <nav class="hidden items-center gap-6 text-[12px] font-medium uppercase tracking-[0.1em] text-white/60 lg:flex">
      <details class={`group relative ${noMarker}`}>
        <summary class="flex cursor-pointer list-none items-center gap-1.5 text-acc">
          {t('nav.services')} <span class="text-[8px] leading-none">▼</span>
        </summary>
        <div class="absolute -left-[18px] top-[calc(100%+16px)] z-30 flex min-w-[260px] flex-col border border-white/12 bg-[#0e0e0e] p-2.5 shadow-[0_34px_70px_-34px_rgba(0,0,0,0.95)]">
          {services.map((s) => (
            <a
              href={s.href}
              class:list={[
                'flex items-baseline justify-between gap-3.5 px-3.5 py-3 text-[12px] tracking-[0.08em] hover:bg-white/5',
                routeKey === s.key ? 'font-semibold text-acc' : 'font-medium text-white'
              ]}
            >
              {s.label}
              {s.note && <span class="text-[10px] font-medium tracking-[0.14em] text-white/40">{s.note}</span>}
            </a>
          ))}
        </div>
      </details>
      {navLinks.map((l) => (
        <a href={l.href} class:list={{ 'text-acc': routeKey === l.key }}>{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={altHref}
        hreflang={otherLocale}
        class="hidden text-[11px] font-bold uppercase tracking-[0.16em] text-white/50 hover:text-acc sm:inline"
      >
        {otherLocale === 'ar' ? 'العربية' : 'FR'}
      </a>
      <span class="hidden sm:inline-flex">
        <Button href={finalCtaHref} variant="outline">{finalCtaLabel}</Button>
      </span>
      <details class={`relative lg:hidden ${noMarker}`}>
        <summary class="cursor-pointer list-none rounded-full border border-white/25 px-3 py-2 text-[11px] uppercase tracking-[0.14em]">
          Menu
        </summary>
        <div class="absolute right-0 top-[calc(100%+12px)] z-30 flex w-[240px] flex-col gap-1 border border-white/12 bg-[#0e0e0e] p-3">
          {[...services, ...navLinks].map((l) => (
            <a href={l.href} class="px-2 py-2 text-[12px] uppercase tracking-[0.08em] text-white/70 hover:text-acc">{l.label}</a>
          ))}
          <a href={altHref} hreflang={otherLocale} class="px-2 py-2 text-[12px] uppercase tracking-[0.08em] text-white/70 hover:text-acc">
            {otherLocale === 'ar' ? 'العربية' : 'FR'}
          </a>
        </div>
      </details>
    </div>
  </div>
</header>
