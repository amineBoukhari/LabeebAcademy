---
import { Image } from 'astro:assets';

const { src = null, alt = '', label = 'Photo', class: className = '', sizes } = Astro.props;
---

{src ? (
  <Image src={src} alt={alt} class={className} sizes={sizes} />
) : (
  <div class={`flex min-h-[160px] items-center justify-center border border-white/10 bg-white/5 p-4 text-center text-[11px] font-semibold uppercase tracking-[0.14em] text-white/35 ${className}`}>
    {`Photo — ${label}`}
  </div>
)}
