---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { dirFor } from '../i18n/utils.js';
import '../styles/global.css';

const {
  title,
  description = '',
  locale = 'fr',
  routeKey = 'home',
  ctaHref = null,
  ctaLabel = null,
  bg = 'bg-bg',
  headerBg = 'bg-bg/85'
} = Astro.props;

const dir = dirFor(locale);
---

<html lang={locale} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} — Labeeb Academy</title>
    {description && <meta name="description" content={description} />}
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Manrope:wght@300;400;500;600;700&family=Mirza:wght@400;500;600&family=Noto+Naskh+Arabic:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class:list={['overflow-x-hidden text-white', bg]}>
    <Header locale={locale} routeKey={routeKey} ctaHref={ctaHref} ctaLabel={ctaLabel} headerBg={headerBg} />
    <slot />
    <Footer locale={locale} />
    <script>
      import { initMotion } from '../scripts/motion-fx.js';
      import { initCursorFx } from '../scripts/cursor-fx.js';
      import { initHeroCarousel } from '../scripts/hero-carousel.js';
      import { initPcToggle } from '../scripts/pc-toggle.js';
      import { initRoadmap } from '../scripts/roadmap.js';

      initMotion();
      initCursorFx();
      initHeroCarousel();
      initPcToggle();
      initRoadmap();
    </script>
  </body>
</html>
