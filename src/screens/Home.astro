        </figure>
        <figure class="flex flex-col gap-4">
          <Photo label="Capture 3" class="aspect-[9/16] rounded bg-white/5" />
          <figcaption class="text-[10px] font-bold uppercase tracking-[0.26em] text-white/50">Labeeb Travel</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative overflow-hidden px-5 py-20 sm:px-8 sm:py-28">
    <div class="pointer-events-none absolute bottom-[-12%] right-[2%] z-[1] h-[min(820px,86vw)] w-[min(820px,86vw)] rounded-full blur-2xl" style="background:radial-gradient(circle,rgba(46,230,166,0.16) 0%,transparent 64%)"></div>
    <div class="relative z-[2] mx-auto max-w-[1000px]">
      <div class="mb-11">
        <div class="mb-4.5 text-[11px] font-bold uppercase tracking-[0.3em] text-acc">Questions fréquentes</div>
        <h2 class="max-w-[18ch] font-display text-4xl uppercase leading-[0.96] tracking-tight sm:text-6xl">Ce qu'on nous demande</h2>
      </div>
      <Faq items={faqItems} />
      <div id="formulaire-appel" class="mt-11 flex flex-wrap items-center gap-4.5">
        <span class="font-light text-white/70">Une autre question ?</span>
        <Button href={path('contact', locale)} variant="solid">Poser votre question</Button>
      </div>
    </div>
  </section>
</Base>
